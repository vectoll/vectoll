{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectoll.org/schemas/v0.1/payment-challenge.schema.json",
  "title": "Vectoll HTTP 402 Payment Challenge",
  "type": "object",
  "required": [
    "x402Version",
    "protocol",
    "challengeId",
    "service",
    "resource",
    "method",
    "reqHash",
    "amount",
    "currency",
    "decimals",
    "settlementMode",
    "requireMandate",
    "facilitatorUrl",
    "facilitatorKid",
    "acceptedRails",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "x402Version": { "type": "integer", "const": 2 },
    "protocol": { "type": "string", "const": "vectoll/0.1" },
    "challengeId": { "type": "string" },
    "service": { "type": "string" },
    "resource": { "type": "string" },
    "method": { "type": "string" },
    "reqHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "amount": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string" },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 18 },
    "settlementMode": { "type": "string", "enum": ["instant", "escrow"] },
    "requireMandate": { "type": "boolean" },
    "hitlThreshold": { "type": ["integer", "null"] },
    "facilitatorUrl": { "type": "string" },
    "facilitatorKid": { "type": "string" },
    "acceptedRails": { "type": "array", "items": { "type": "string" } },
    "issuedAt": { "type": "integer" },
    "expiresAt": { "type": "integer" }
  }
}
