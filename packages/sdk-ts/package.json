{
  "name": "@vectoll/sdk",
  "version": "1.0.0",
  "description": "TypeScript Agent & MCP Client SDK for automatic HTTP 402 negotiation, Spend Mandate enforcement, and multi-rail payments",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@vectoll/core": "workspace:*"
  },
  "devDependencies": {
    "@vectoll/edge": "workspace:*",
    "@vectoll/facilitator": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js"
  }
}
