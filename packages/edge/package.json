{
  "name": "@vectoll/edge",
  "version": "1.0.0",
  "description": "Vectoll Edge & Reverse Proxy middleware (Fetch / Cloudflare Workers & Node HTTP) with local Ed25519 VRT verification and MCP auto-wrapper",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@vectoll/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js"
  }
}
